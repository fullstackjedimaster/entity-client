NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3005
HOSTNAME=0.0.0.0

# Next.js server-side proxy target for browser requests made to /api/*.
API_PROXY_TARGET=http://host.docker.internal:8003
NEXT_PUBLIC_EC_API_BASE_URL=/api
NEXT_PUBLIC_EC_DEFAULT_JWT=

# Shared framework-neutral Modular RAG adapter.
NEXT_PUBLIC_RAG_DOCK_SCRIPT_URL=https://rag.fullstackjedi.dev/dock-host.js
NEXT_PUBLIC_HOST_APP_ID=entity-client
NEXT_PUBLIC_HOST_DENSITY=compact

NEXT_PUBLIC_EMBED_LOCK_ENABLED=true
