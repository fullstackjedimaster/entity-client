NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3005
HOSTNAME=0.0.0.0

# Next.js server-side proxy target for browser requests made to /api/*.
API_PROXY_TARGET=http://host.docker.internal:8003
NEXT_PUBLIC_EC_API_BASE_URL=/api
NEXT_PUBLIC_EC_DEFAULT_JWT=

NEXT_PUBLIC_DOCK_FRAME_ID=entity-client-dock
NEXT_PUBLIC_DOCK_ORIGIN=https://rag.fullstackjedi.dev
NEXT_PUBLIC_RAG_API_BASE=https://rag.fullstackjedi.dev
NEXT_PUBLIC_RAG_CORE_BASE=https://ai-core.fullstackjedi.dev
NEXT_PUBLIC_RAG_CLIENT_NAME=entity-client

NEXT_PUBLIC_EMBED_LOCK_ENABLED=true
